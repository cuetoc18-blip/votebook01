---
---
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Votebook · Entrar</title>
  <style>
    body { margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center;
      font-family: ui-sans-serif, system-ui, sans-serif; background:#f1f5f9; }
    .card { width:100%; max-width:380px; background:#fff; border:1px solid #e2e8f0; border-radius:20px; padding:28px 24px; }
    img.logo { height:56px; width:auto; display:block; margin:0 auto 16px; }
    h1 { text-align:center; font-size:20px; margin:0 0 16px; color:#0f172a; }
    label { display:block; font-size:12px; font-weight:600; color:#475569; margin:10px 0 4px; }
    input { width:100%; box-sizing:border-box; padding:10px 12px; border:1px solid #e2e8f0; border-radius:12px; font-size:14px; }
    button { width:100%; margin-top:16px; background:#4f46e5; color:#fff; border:0; border-radius:12px; padding:12px; font-weight:700; cursor:pointer; }
    button:disabled { opacity:.6; }
    #login-status { text-align:center; font-size:13px; min-height:20px; margin:10px 0 0; color:#64748b; }
    #login-status.err { color:#e11d48; }
    .foot { text-align:center; font-size:11px; color:#94a3b8; margin-top:16px; }
  </style>
</head>
<body>
  <div class="card">
    <img class="logo" src="/img/votebook.png" alt="Votebook" />
    <h1>Entrar al panel</h1>
    <form id="login-form">
      <label>Correo</label>
      <input type="email" id="login-email" required autocomplete="username" placeholder="tu@correo.com" />
      <label>Contraseña</label>
      <input type="password" id="login-password" required autocomplete="current-password" placeholder="••••••••" />
      <button type="submit" id="login-submit">Entrar al panel</button>
      <p id="login-status"></p>
    </form>
    <p class="foot">Carlos Cueto Mejía · Edil Norte-Centro Histórico</p>
  </div>
  <script is:inline src="/js/api-client.js"></script>
  <script is:inline>
    (function () {
      function status(msg, err) {
        var el = document.getElementById('login-status');
        if (!el) return;
        el.textContent = msg || '';
        el.className = err ? 'err' : '';
      }
      fetch('/api/auth/me', { credentials: 'include' }).then(function (r) { return r.json(); }).then(function (d) {
        if (d && d.ok) location.replace('/app');
      }).catch(function () {});
      document.getElementById('login-form').addEventListener('submit', async function (ev) {
        ev.preventDefault();
        var email = document.getElementById('login-email').value.trim();
        var pass = document.getElementById('login-password').value;
        var btn = document.getElementById('login-submit');
        btn.disabled = true; btn.textContent = 'Entrando...'; status('Validando...', false);
        try {
          var r = await fetch('/api/auth/login', {
            method: 'POST', credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email, password: pass })
          });
          var d = await r.json();
          if (!r.ok || !d.ok) throw new Error(d.error || 'Credenciales inválidas');
          status('Correcto. Cargando panel...', false);
          location.replace('/app');
        } catch (e) {
          status(e.message || 'Error', true);
          btn.disabled = false; btn.textContent = 'Entrar al panel';
        }
      });
    })();
  </script>
</body>
</html>
